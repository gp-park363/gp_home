# 복사해서 사용: cp .env.example .env   (make setup이 자동으로 해 줍니다)
# 운영 서버에서는 APP_ENV=prod 와 아래 '운영 필수' 항목을 반드시 바꿉니다.

APP_ENV=dev
SITE_URL=http://localhost:8000
# 운영 필수: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=dev-only-insecure-secret

# ── DB (Compose의 db 컨테이너) ──────────────────────────────
POSTGRES_USER=goodpackage
POSTGRES_PASSWORD=goodpackage
POSTGRES_DB=goodpackage
# 호스트에서 uv run으로 테스트·마이그레이션할 때 사용 (컨테이너 안에서는 db:5432로 자동 대체)
DATABASE_URL=postgresql+psycopg://goodpackage:goodpackage@localhost:5432/goodpackage

# ── 호스트 포트 (로컬 개발) ────────────────────────────────
WEB_PORT=8000
DB_PORT=5432
MAILPIT_PORT=8025

# ── 파일 저장 (호스트에서 실행 시) ──────────────────────────
MEDIA_ROOT=./var/media

# ── 메일: 로컬은 Mailpit(http://localhost:8025)이 가로챕니다 ─
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_STARTTLS=false
MAIL_FROM="좋은상자 <no-reply@goodpackage.co.kr>"
STAFF_NOTIFY_EMAILS=[]

# ── Cloudflare Turnstile: 아래는 Cloudflare 공식 테스트 키 (운영 필수 교체) ─
TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# ── 외부 서비스 ────────────────────────────────────────────
ALIMTALK_ENABLED=false
NAVER_MAP_CLIENT_ID=
KAKAO_CHANNEL_ID=
